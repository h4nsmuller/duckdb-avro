# name: test/sql/copy/wide_decimal.test
# description: DECIMALs of more than 38 digits are written as Avro decimals and read back exactly
# group: [copy]

require avro

# The sizes continue those of the narrower decimals: the smallest n with floor(log10(2^(8n - 1) - 1)) >= P
statement ok
CREATE TABLE expected_size(p INTEGER, bytes INTEGER);

statement ok
INSERT INTO expected_size VALUES
	(39, 17), (40, 17), (41, 18), (76, 32), (77, 33), (100, 42), (255, 107), (256, 107), (300, 125), (1000, 416);

foreach p 39 40 41 76 77 100 255 256 300 1000

# The largest and smallest P-digit values have their top bit in the first byte, the values around a power of 256
# change the number of bytes of the magnitude
statement ok
CREATE OR REPLACE TABLE wide AS
SELECT i, c::DECIMAL({p}, 0) AS c
FROM (VALUES
	(0, repeat('9', {p})), (1, '-' || repeat('9', {p})), (2, NULL), (3, '0'), (4, '-1'), (5, '1'), (6, '-128'),
	(7, '-129'), (8, '-255'), (9, '-256'), (10, '-257'), (11, '255'), (12, '256'),
	(13, '-340282366920938463463374607431768211456'), (14, '340282366920938463463374607431768211455'),
	(15, '1' || repeat('0', {p} - 1)), (16, '-1' || repeat('0', {p} - 1))
) t(i, c);

statement ok
COPY wide TO '{TEST_DIR}/wide_decimal_p{p}.avro';

query I
SELECT CASE WHEN size = bytes THEN 'ok' ELSE 'size ' || size || ', expected ' || bytes END
FROM (
	SELECT regexp_extract(value, '"type":"fixed"[^}]*"size":([0-9]+)', 1)::INTEGER AS size
	FROM avro_metadata('{TEST_DIR}/wide_decimal_p{p}.avro')
	WHERE key = 'avro.schema'
), expected_size
WHERE p = {p};
----
ok

query I
SELECT regexp_extract(value, '"logicalType":"decimal","precision":([0-9]+),"scale":0', 1) = '{p}'
FROM avro_metadata('{TEST_DIR}/wide_decimal_p{p}.avro')
WHERE key = 'avro.schema';
----
true

query I
SELECT typeof(c) = 'DECIMAL({p},0)' FROM read_avro('{TEST_DIR}/wide_decimal_p{p}.avro') LIMIT 1;
----
true

query II
SELECT count(*), count(c) FROM read_avro('{TEST_DIR}/wide_decimal_p{p}.avro');
----
17	16

query II
(FROM wide EXCEPT FROM read_avro('{TEST_DIR}/wide_decimal_p{p}.avro'))
UNION ALL
(FROM read_avro('{TEST_DIR}/wide_decimal_p{p}.avro') EXCEPT FROM wide);
----

endloop

# a scale, next to narrower decimals
statement ok
CREATE TABLE scaled(i INTEGER, dec_50_2 DECIMAL(50, 2), dec_38_10 DECIMAL(38, 10), dec_300_300 DECIMAL(300, 300));

statement ok
INSERT INTO scaled VALUES
	(1, '123456789012345678901234567890123456789.50', 1.5, '0.' || repeat('7', 300)),
	(2, -0.01, -1.5, '-0.' || repeat('0', 299) || '1'),
	(3, NULL, NULL, NULL),
	(4, '-' || repeat('9', 48) || '.99', 0, 0);

statement ok
COPY scaled TO '{TEST_DIR}/wide_decimal_scaled.avro';

query TT
SELECT column_name, column_type FROM (DESCRIBE FROM read_avro('{TEST_DIR}/wide_decimal_scaled.avro'));
----
i	INTEGER
dec_50_2	DECIMAL(50,2)
dec_38_10	DECIMAL(38,10)
dec_300_300	DECIMAL(300,300)

query III
SELECT i, dec_50_2, dec_38_10 FROM read_avro('{TEST_DIR}/wide_decimal_scaled.avro') ORDER BY i;
----
1	123456789012345678901234567890123456789.50	1.5000000000
2	-0.01	-1.5000000000
3	NULL	NULL
4	-999999999999999999999999999999999999999999999999.99	0.0000000000

query IIII
(FROM scaled EXCEPT FROM read_avro('{TEST_DIR}/wide_decimal_scaled.avro'))
UNION ALL
(FROM read_avro('{TEST_DIR}/wide_decimal_scaled.avro') EXCEPT FROM scaled);
----

# nested: struct fields, list elements and map values (every one of them a union with null)
statement ok
CREATE TABLE nested AS
SELECT * FROM (VALUES
	(1, {'a': 1.5::DECIMAL(40, 1), 'b': -2::DECIMAL(255, 0)}, [1.25::DECIMAL(76, 2), NULL, -1.25],
	 MAP {'k': 12345678901234567890123456789012345678901234567890::DECIMAL(50, 0)}),
	(2, NULL, NULL, NULL),
	(3, {'a': NULL, 'b': NULL}, [], MAP {'k': NULL})
) t(i, s, l, m);

statement ok
COPY nested TO '{TEST_DIR}/wide_decimal_nested.avro';

query IIII
SELECT i, s, l, m FROM read_avro('{TEST_DIR}/wide_decimal_nested.avro') ORDER BY i;
----
1	{'a': 1.5, 'b': -2}	[1.25, NULL, -1.25]	{k=12345678901234567890123456789012345678901234567890}
2	NULL	NULL	NULL
3	{'a': NULL, 'b': NULL}	[]	{k=NULL}

query I
SELECT typeof(s) || ' ' || typeof(l) || ' ' || typeof(m)
FROM read_avro('{TEST_DIR}/wide_decimal_nested.avro') LIMIT 1;
----
STRUCT(a DECIMAL(40,1), b DECIMAL(255,0)) DECIMAL(76,2)[] MAP(VARCHAR, DECIMAL(50,0))

# many rows, in several chunks and with every codec
statement ok
CREATE TABLE many AS
SELECT i, CASE WHEN i % 7 = 0 THEN NULL
          ELSE (i::DECIMAL(60, 0) * 1000000007 * 1000000009 * 998244353 - 5000000)::DECIMAL(60, 4) END AS d
FROM range(-10000, 10000) t(i);

foreach codec null deflate snappy zstandard

statement ok
COPY many TO '{TEST_DIR}/wide_decimal_rows.avro' (CODEC '{codec}');

query III
SELECT count(*), count(d), sum(d) = (SELECT sum(d) FROM many)
FROM read_avro('{TEST_DIR}/wide_decimal_rows.avro');
----
20000	17143	true

query II
(FROM many EXCEPT FROM read_avro('{TEST_DIR}/wide_decimal_rows.avro'))
UNION ALL
(FROM read_avro('{TEST_DIR}/wide_decimal_rows.avro') EXCEPT FROM many);
----

endloop

# the fixtures written by another Avro library survive a rewrite
statement ok
COPY (FROM read_avro('test/wide_decimal_bytes.avro')) TO '{TEST_DIR}/wide_decimal_rewrite.avro';

query IIIII
(FROM read_avro('test/wide_decimal_bytes.avro') EXCEPT FROM read_avro('{TEST_DIR}/wide_decimal_rewrite.avro'))
UNION ALL
(FROM read_avro('{TEST_DIR}/wide_decimal_rewrite.avro') EXCEPT FROM read_avro('test/wide_decimal_bytes.avro'));
----

# a width above the widest DECIMAL of the session cannot be created to begin with
statement error
COPY (SELECT 1::DECIMAL(2000000, 0) AS d) TO '{TEST_DIR}/wide_decimal_error.avro';
----
exceeds the maximum DECIMAL width of 1000000
